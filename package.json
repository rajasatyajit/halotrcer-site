{
  "name": "halotrcer-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "astro": "7.4.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.5",
    "dejavu-fonts-ttf": "2.37.3",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "1.7.0",
    "html-validate": "11.17.0",
    "node-html-parser": "9.0.5",
    "pagefind": "1.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "scripts": {
    "dev": "SITE_ID=${SITE_ID:-www} astro dev",
    "build": "node scripts/build.ts",
    "build:prelaunch": "LAUNCHED=false node scripts/build.ts",
    "preview": "SITE_ID=${SITE_ID:-www} astro preview",
    "typecheck": "SITE_ID=www astro check",
    "lint": "eslint . && stylelint \"src/**/*.css\" && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:headers": "node scripts/check-headers.ts",
    "check:prelaunch": "node scripts/check-prelaunch.ts",
    "check:claims": "node scripts/check-claims.ts",
    "verify:claims": "node scripts/verify-claims.ts",
    "budget": "node scripts/check-budgets.ts",
    "check:dist": "npm run check:html && npm run check:headers && npm run check:claims && npm run check:seo && npm run check:jsonld && npm run budget",
    "sync:docs": "node scripts/sync-docs.ts",
    "check:seo": "node scripts/check-seo.ts",
    "check:links": "node scripts/check-links.ts",
    "check:permanence": "node scripts/check-permanence.ts",
    "urls:record": "node scripts/record-urls.ts",
    "e2e": "playwright test",
    "serve": "node scripts/serve.ts",
    "sync:releases": "node scripts/sync-releases.ts",
    "fixtures:releases": "node scripts/fixture-releases.ts",
    "build:launched-fixture": "node scripts/fixture-releases.ts && RELEASE_DATA_DIR=.cache/fixture-releases LAUNCHED=true ALLOW_CANDIDATE_SCRIPTS=1 node scripts/build.ts",
    "check:launched": "node scripts/check-launched.ts",
    "verify:scripts": "node scripts/verify-scripts.ts",
    "sync:samples": "node scripts/sync-samples.ts",
    "check:jsonld": "node scripts/check-jsonld.ts"
  }
}
