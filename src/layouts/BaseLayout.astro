---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_NAMES, url } from '../config/site.ts';
import { getFlags } from '../config/flags.ts';
import { canonicalPath } from '../lib/paths.ts';
import { breadcrumbs, serialize, type Crumb, type JsonLd } from '../lib/jsonld.ts';
import { ogImagePath } from '../lib/og.ts';

interface Props {
  title: string;
  description: string;
  // Use the site name alone as the title (home pages).
  bareTitle?: boolean;
  noindex?: boolean;
  // Structured data for this page; breadcrumbs are added for every page but the home.
  jsonld?: JsonLd[];
  crumbs?: Crumb[];
  // Open Graph image: a label drawn into the image (e.g. "Simulated demo run"),
  // or the pricing template that lists the services and their prices.
  ogStamp?: string;
  ogTemplate?: 'pricing';
  // The page's ground: paper (docs, blog, legal) or wood (sample reports, as case files).
  surface?: 'paper' | 'wood';
  // The page shows simulated sample data: the footer then says where its numbers come from.
  // Defaults to a "Simulated…" share-image stamp.
  samples?: boolean;
}

const {
  title,
  description,
  bareTitle = false,
  noindex = false,
  jsonld = [],
  crumbs,
  ogStamp,
  ogTemplate,
  surface,
  samples = ogStamp?.startsWith('Simulated') ?? false,
} = Astro.props;
const { site } = getFlags();
const siteName = SITE_NAMES[site];
const fullTitle = bareTitle ? title : `${title} · ${siteName}`;
const path = canonicalPath(Astro.url.pathname);
const canonical = url(site, path);
const ogImage = url(site, ogImagePath(path));
const isHome = path === '/';
const graph = [
  ...jsonld,
  ...(!isHome && !noindex ? [breadcrumbs(site, crumbs ?? [{ name: title, path }])] : []),
];
---

<!doctype html>
<html lang="en" data-site={site}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f2e2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1f1a14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {!noindex && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={fullTitle} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    {graph.length > 0 && (
      <script is:inline type="application/ld+json" set:html={serialize(graph)} />
    )}
    <script is:inline src="/theme-init.js"></script>
    <slot name="head" />
  </head>
  <body data-og-stamp={ogStamp} data-og-template={ogTemplate}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" class:list={[surface && `${surface}-main`]}>
      <slot />
    </main>
    <SiteFooter samples={samples} />
  </body>
</html>
