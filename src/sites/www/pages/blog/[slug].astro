---
import { render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import DraftNotice from '../../../../components/DraftNotice.astro';
import ShareButton from '../../../../components/ShareButton.astro';
import { posts, type BlogEntry } from '../../../../lib/blog.ts';
import { FEED } from '../../../../lib/feeds.ts';
import { blogPosting } from '../../../../lib/jsonld.ts';

export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: BlogEntry };
const { title, description, draft, published, updated } = post.data;
const { Content } = await render(post);
const date = (d: Date) => d.toISOString().slice(0, 10);
const jsonld =
  !draft && published
    ? [blogPosting({ slug: post.id, title, description, published, updated })]
    : [];
---

<BaseLayout
  title={title}
  description={description}
  noindex={draft}
  jsonld={jsonld}
  crumbs={[
    { name: 'Blog', path: '/blog' },
    { name: title, path: `/blog/${post.id}` },
  ]}

  surface="paper"
>
  <link slot="head" rel="alternate" type="application/rss+xml" title={FEED.title} href={FEED.rss} />
  <article class="container section">
    <header class="page-head">
      <p class="eyebrow">
        <a href="/blog">Blog</a>
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {published && !draft && (
        <p>
          Published <time datetime={date(published)}>{date(published)}</time>
          {updated && (
            <>
              , updated <time datetime={date(updated)}>{date(updated)}</time>
            </>
          )}
        </p>
      )}
      <div class="button-row">
        <ShareButton />
      </div>
    </header>
    {draft && <DraftNotice outline />}
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
