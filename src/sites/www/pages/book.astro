---
import EmailAddress from '../../../components/EmailAddress.astro';
// Fallback for /book while BOOKING_TARGET is unset. Once it is set, this page is
// not built and _redirects sends /book to the booking tool (302).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../../../config/site.ts';
---

<BaseLayout
  title="Book a call"
  description="Book a call with Halotrcer about LLM inference cost and latency or MCP agent security."
  noindex
>
  <div class="container section">
    <h1>Book a call</h1>
    <p class="lede">
      Online booking isn’t connected yet. Email us and we’ll find a time that works.
    </p>
    <div class="button-row">
      <a class="button" href={`mailto:${CONTACT_EMAIL}?subject=Book%20a%20call`}>
        Email <EmailAddress />
      </a>
    </div>
  </div>
</BaseLayout>
