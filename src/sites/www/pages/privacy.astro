---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DraftNotice from '../../../components/DraftNotice.astro';
import { BOOKING_TARGET, CONTACT_EMAIL, url } from '../../../config/site.ts';
import { getFlags } from '../../../config/flags.ts';

const { analytics } = getFlags();
---

<BaseLayout
  title="Privacy"
  description="What www.halotrcer.com, tokvera.halotrcer.com and sievant.halotrcer.com collect: no cookies, no third-party scripts, and what happens when you email or book a call."
>
  <header class="container page-head">
    <h1>Privacy</h1>
    <p class="lede">
      This covers the three Halotrcer sites: www.halotrcer.com, tokvera.halotrcer.com and
      sievant.halotrcer.com. The tools themselves are covered on the
      <a href={url('www', '/security')}>security page</a>.
    </p>
  </header>
  <div class="container prose">
    <DraftNotice />

    <h2>What the sites collect</h2>
    <ul>
      <li>No cookies, no accounts and no third-party scripts or fonts.</li>
      {analytics ? (
        <li>
          Page views are counted with Cloudflare Web Analytics, which is cookieless and does not
          identify you.
        </li>
      ) : (
        <li>No analytics.</li>
      )}
      <li>
        A theme choice, if you make one, is kept in your browser’s local storage and never sent to
        us.
      </li>
      <li>
        The sites are hosted on Cloudflare Pages. Like any web host, Cloudflare processes request
        data such as IP addresses to serve and protect the sites; see
        <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare’s privacy policy</a>.
      </li>
    </ul>

    <h2>When you contact us</h2>
    <ul>
      <li>
        If you email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, we use your message
        and address to reply, and keep them as correspondence.
      </li>
      {BOOKING_TARGET && (
        <li>
          If you book a call, the booking tool processes the details you enter, under its own
          privacy policy.
        </li>
      )}
      <li>We don’t sell or share your details, and we don’t add you to a mailing list.</li>
    </ul>

    <h2>Questions</h2>
    <p>
      Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
    </p>
  </div>
</BaseLayout>
