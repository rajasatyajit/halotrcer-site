---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Proof from '../../../components/Proof.astro';
import Claim from '../../../components/Claim.astro';
import CopyButtons from '../../../components/CopyButtons.astro';
import InstallOrSoon from '../../../components/InstallOrSoon.astro';
import PriceCard from '../../../components/PriceCard.astro';
import CaseOpening from '../../../components/board/CaseOpening.astro';
import { BOOKING_URL, CONTACT_EMAIL, url } from '../../../config/site.ts';
import { loadPricing } from '../../../lib/pricing.ts';
import { organization, softwareApplication, website } from '../../../lib/jsonld.ts';

const { services } = loadPricing();
// The address may wrap only after the @ (copying reads the text, which the <wbr> leaves whole).
const [emailUser, emailDomain] = CONTACT_EMAIL.split('@');
const jsonld = [organization(), website(), softwareApplication('halotrcer')];
---

<BaseLayout
  title="Halotrcer: find AI spend leaks and agent exposures"
  description="Is your AI slow, expensive or leaking? Halotrcer puts two detectives on the case, on your own system: Tokvera on your LLM endpoint and Sievant on your agents' tools."
  bareTitle
  jsonld={jsonld}
  ogStamp="Simulated demo runs"
>
  <CaseOpening site="www">
    <h1 id="case-title">
      <Claim id="www.case.title" />
    </h1>
    <p class="lede">
      <Claim id="www.case.lede" /> Here's what they pinned up after their simulated demo runs.
    </p>
  </CaseOpening>

  <section class="paper-section" aria-labelledby="fees">
    <div class="container">
      <h2 id="fees">Hire the detectives</h2>
      <ul class="price-band">
        {services.map((s) => (
          <li>
            <PriceCard service={s} compact />
          </li>
        ))}
      </ul>
      <p>
        <a href={url('www', '/pricing')}>What each one delivers</a>
      </p>

      <div class="grid-3 case-notes">
        <div>
          <h3>Where your data goes</h3>
          <p>
            <Claim id="tokvera.no-telemetry" />
          </p>
          <p>
            <Claim id="sievant.no-telemetry" />
          </p>
        </div>
        <div>
          <h3>What if you stop maintaining it?</h3>
          <p>
            <Claim id="www.continuity" />
          </p>
          <p>
            <a href={url('www', '/security')}>Security and continuity</a>
          </p>
        </div>
        <div>
          <h3>One ranked fix list</h3>
          <p>
            <Claim id="halotrcer.fix-plan" /> Provisional.
          </p>
          <p>
            <a href={url('www', '/scoring')}>How findings are ranked</a>
          </p>
        </div>
      </div>

      <div class="contact-row">
        <span id="contact-email" class="contact-email">
          {emailUser}@<wbr />
          {emailDomain}
        </span>
        <button class="button button--ghost js-only" type="button" data-copy="contact-email">
          Copy email
        </button>
        <a class="button" href={BOOKING_URL}>
          Book a call
        </a>
      </div>
    </div>
  </section>

  <Proof />

  <section class="container section">
    <InstallOrSoon product="halotrcer" />
  </section>
  <CopyButtons />
</BaseLayout>
