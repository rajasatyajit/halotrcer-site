---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShareButton from '../../../components/ShareButton.astro';
import SourceLine from '../../../components/SourceLine.astro';
import SimulatedStamp from '../../../components/SimulatedStamp.astro';
import Severity from '../../../components/Severity.astro';
import { sample } from '../../../lib/samples.ts';
import { priceLabel, serviceFor } from '../../../lib/pricing.ts';

interface Posture {
  organization: string;
  period: { label: string };
  summary: { coverage: { headline: string; policy: string } };
  controls: { id: string; name: string; status: string; detail: string }[];
  activity: {
    requests: number;
    blocked: number;
    input_redactions: number;
    output_redactions: number;
  };
  gaps: { severity: string; title: string; detail: string; fix: string }[];
  disclaimer: string;
}
interface Scan {
  counts: Record<string, number>;
  findings: {
    rule: string;
    severity: string;
    title: string;
    client: string;
    server: string;
    where: string;
    fix: string;
  }[];
}

const posture = sample<Posture>('sievant-posture');
const scan = sample<Scan>('sievant-scan');
const p = posture.data;
const s = scan.data;
const SEVERITIES = ['critical', 'high', 'medium', 'low', 'info'];
const review = serviceFor('agent-security-review');
---

<BaseLayout
  title="Sample Agent Security Review report"
  description="What an Agent Security Review delivers, and a sample Sievant posture report from a simulated run for a fictional organization, plus a scan of risky MCP client configurations."
  ogStamp="Simulated demo run"
>
  <header class="container page-head">
    <p class="eyebrow">Sample report</p>
    <h1>Sample Agent Security Review report</h1>
    <p class="lede">
      The posture report (<code>sievant report</code>) is what you attach to a customer’s security
      review. Here it is rendered from a simulated run for a fictional organization, followed by a
      client-configuration scan (<code>sievant scan</code>).
    </p>
    <div class="button-row">
      <ShareButton />
    </div>
  </header>

  <section class="container section" id="review" aria-labelledby="review-h">
    <h2 id="review-h">What the review delivers, and what this sample shows</h2>
    <div class="layout-split">
      <div class="panel" data-owner-source="content/pricing.md">
        <h3>The review</h3>
        <ul>
          {review.deliverables.map((d) => (
            <li>{d}</li>
          ))}
        </ul>
        <p>
          {review.name}: {priceLabel(review, { inSentence: true })}, {review.duration.toLowerCase()}
          .
        </p>
      </div>
      <div
        class="panel panel--sample"
        data-sample={`${posture.source.repo}:${posture.source.path}@${posture.source.commit}`}
      >
        <h3>
          This sample <SimulatedStamp />
        </h3>
        <p>
          <strong>{p.summary.coverage.headline}</strong>
        </p>
        <ul class="plain-list">
          {p.gaps.map((g) => (
            <li>
              <Severity level={g.severity} /> {g.title}
            </li>
          ))}
        </ul>
        <p class="source-note">
          The statuses here describe {p.organization}’s simulated deployment, not the scope of the
          review.
        </p>
      </div>
    </div>
  </section>

  <div class="container">
    <SourceLine source={posture.source} />
  </div>

  <div
    class="container"
    data-sample={`${posture.source.repo}:${posture.source.path}@${posture.source.commit}`}
  >
    <section class="section" id="posture-report" aria-labelledby="posture">
      <div class="section-head">
        <h2 id="posture">
          Posture report: {p.organization}, last {p.period.label}
        </h2>
        <SimulatedStamp path={posture.source.path} />
      </div>
      <p class="note">
        <strong>{p.summary.coverage.headline}</strong> {p.summary.coverage.policy}
      </p>
      <p>
        {p.activity.requests} calls recorded; {p.activity.blocked} blocked;{' '}
        {p.activity.input_redactions} argument redactions and {p.activity.output_redactions} result
        redactions.
      </p>
      <h3>Coverage gaps</h3>
      <ul class="checklist">
        {p.gaps.map((g) => (
          <li>
            <Severity level={g.severity} /> <strong>{g.title}.</strong> {g.detail} <em>Fix:</em>{' '}
            {g.fix}
          </li>
        ))}
      </ul>
      <h3>Controls</h3>
      <div class="table-wrap only-wide" tabindex="0">
        <table>
          <caption>
            {`Controls, ${p.organization}`}
            <SimulatedStamp />
          </caption>
          <thead>
            <tr>
              <th scope="col">Control</th>
              <th scope="col">Status</th>
              <th scope="col">Detail</th>
            </tr>
          </thead>
          <tbody>
            {p.controls.map((c) => (
              <tr>
                <td>{c.name}</td>
                <td class="status">{c.status}</td>
                <td>{c.detail}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="only-narrow">
        <p class="card-list__caption">
          {`Controls, ${p.organization}`} <SimulatedStamp />
        </p>
        <ul class="card-list">
          {p.controls.map((c) => (
            <li>
              <strong>{c.name}</strong> <span class="status">{c.status}</span>
              <p>{c.detail}</p>
            </li>
          ))}
        </ul>
      </div>
      <p class="note">{p.disclaimer}</p>
    </section>
  </div>

  <div class="container">
    <SourceLine source={scan.source} />
  </div>

  <div
    class="container"
    data-sample={`${scan.source.repo}:${scan.source.path}@${scan.source.commit}`}
  >
    <section class="section" id="scan-report" aria-labelledby="scan">
      <div class="section-head">
        <h2 id="scan">Client-configuration scan</h2>
        <SimulatedStamp path={scan.source.path} />
      </div>
      <p>{SEVERITIES.map((sev) => `${s.counts[sev] ?? 0} ${sev}`).join(', ')}.</p>
      <div class="table-wrap only-wide" tabindex="0">
        <table>
          <caption>
            Scan findings
            <SimulatedStamp />
          </caption>
          <thead>
            <tr>
              <th scope="col">Severity</th>
              <th scope="col">Rule</th>
              <th scope="col">Finding</th>
              <th scope="col">Where</th>
              <th scope="col">Fix</th>
            </tr>
          </thead>
          <tbody>
            {s.findings.map((f) => (
              <tr>
                <td>
                  <Severity level={f.severity} />
                </td>
                <td>
                  <code>{f.rule}</code>
                </td>
                <td>{f.title}</td>
                <td>
                  {f.client} · {f.server} · <code>{f.where}</code>
                </td>
                <td>{f.fix}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="only-narrow">
        <p class="card-list__caption">
          Scan findings <SimulatedStamp />
        </p>
        <ul class="card-list">
          {s.findings.map((f) => (
            <li>
              <Severity level={f.severity} /> <code>{f.rule}</code> <strong>{f.title}</strong>
              <p>
                {f.client} · {f.server} · <code>{f.where}</code>
              </p>
              <p>
                <em>Fix:</em> {f.fix}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
