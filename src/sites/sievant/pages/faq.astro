---
import Continuity from '../../../components/Continuity.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SyncedDoc from '../../../components/SyncedDoc.astro';
import { BOOKING_URL } from '../../../config/site.ts';
import { faqPage } from '../../../lib/jsonld.ts';

const jsonld = [faqPage('sievant/faq')];
---

<BaseLayout
  title="Sievant FAQ"
  description="Does Sievant send anything anywhere? Will it slow my agent down? What does sievant wrap change? Answers from the Sievant documentation."
  jsonld={jsonld}
>
  <header class="container page-head">
    <h1>Frequently asked questions</h1>
    <p class="lede">
      From the Sievant documentation. Not answered here? <a href={BOOKING_URL}>Book a call</a>.
    </p>
  </header>
  <div class="container">
    <SyncedDoc id="sievant/faq" />
  </div>
  {/* From Halotrcer, not the synced doc: the synced wording is never edited. */}
  <section class="container section" aria-labelledby="maintainer">
    <h2 id="maintainer">What if you stop maintaining it?</h2>
    <p>
      <Continuity />
    </p>
  </section>
</BaseLayout>
