---
import Continuity from '../../../components/Continuity.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SyncedDoc from '../../../components/SyncedDoc.astro';
import { BOOKING_URL } from '../../../config/site.ts';
import { faqPage } from '../../../lib/jsonld.ts';

const jsonld = [faqPage('tokvera/faq')];
---

<BaseLayout
  title="Tokvera FAQ"
  description="Is a scan safe on production? What does it cost? Why is the grade provisional? Answers from the Tokvera documentation."
  jsonld={jsonld}
>
  <header class="container page-head">
    <h1>Frequently asked questions</h1>
    <p class="lede">
      From the Tokvera documentation. Not answered here? <a href={BOOKING_URL}>Book a call</a>.
    </p>
  </header>
  <div class="container">
    <SyncedDoc id="tokvera/faq" />
  </div>
  {/* From Halotrcer, not the synced doc: the synced wording is never edited. */}
  <section class="container section" aria-labelledby="maintainer">
    <h2 id="maintainer">What if the maintainer stops?</h2>
    <p>
      <Continuity />
    </p>
  </section>
</BaseLayout>
