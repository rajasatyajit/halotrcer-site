---
import { SITE_NAMES, url } from '../config/site.ts';
import { getFlags } from '../config/flags.ts';
import { navFor } from '../data/nav.ts';
import { canonicalPath } from '../lib/paths.ts';

const { site } = getFlags();
const { items, cta } = navFor(site);
const here = url(site, canonicalPath(Astro.url.pathname));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href={url(site)}>
      {SITE_NAMES[site]}
    </a>
    {/* Two copies of the list, one shown per width (display:none hides the other from
        assistive technology too). The phone copy is a <details>, so it opens without JS. */}
    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.href === here ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <details class="site-nav__menu">
        <summary>Menu</summary>
        <ul>
          {items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === here ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <button class="theme-toggle" type="button" data-theme-toggle data-pending>
              Theme
            </button>
          </li>
        </ul>
      </details>
    </nav>
    <a class="button button--ghost site-header__cta" href={cta.href}>
      {cta.label}
    </a>
    {/* Phones get this button inside the menu instead (one row fits at 320 px). */}
    <button class="theme-toggle site-header__theme" type="button" data-theme-toggle data-pending>
      Theme
    </button>
  </div>
</header>

<script>
  import '../islands/theme-toggle.ts';
</script>
