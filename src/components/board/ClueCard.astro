---
// One clue pinned to the board. Its stamp sits inside its own border, so a cropped card
// keeps its label (scripts/check-stamps.ts fails on a [data-clue] without one).
import Claim from '../Claim.astro';
import SimulatedStamp from '../SimulatedStamp.astro';
import type { Clue } from '../../lib/clues.ts';
import { inMarkerSubset } from '../../lib/fonts.ts';

interface Props {
  clue: Clue;
  // 0-based position on the board; picks the card's tilt.
  index: number;
}

const { clue, index } = Astro.props;
// Titles and figures carry sample values (server names, numbers); one outside the Marker
// subset is set in bold body type rather than mixing in fallback glyphs.
const plain = !inMarkerSubset(clue.title);
const plainFigure = !inMarkerSubset(clue.figure);
---

<div class="clue-wrap" data-sample={clue.sample}>
  <article class={`clue clue--r${index + 1}`} data-clue>
    <p class="clue__kind">{clue.kind}</p>
    <h3 class:list={['clue__title', { 'clue__title--plain': plain }]}>{clue.title}</h3>
    <p class:list={['clue__figure', { 'clue__figure--plain': plainFigure }]}>{clue.figure}</p>
    <p class="clue__body">{clue.bodyClaim ? <Claim id={clue.bodyClaim} /> : clue.body}</p>
    <p class="clue__source">
      Source: <a href={clue.href}>{clue.tool} sample report</a>
      {clue.detail && ` · ${clue.detail}`}
    </p>
    <SimulatedStamp />
  </article>
</div>
