---
// One service from content/pricing.md (owner-set prices: data-owner-source): kicker, name,
// price and duration. The deliverables are listed separately (/pricing "Before you book").
import { priceLabel, type Service } from '../lib/pricing.ts';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}

const { service, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class={`price-card price-card--${service.product}`} data-owner-source="content/pricing.md">
  <p class="price-card__kicker">{service.kicker}</p>
  <Heading class="price-card__name" id={`service-${service.id}`}>
    {service.name}
  </Heading>
  <p class="price-card__price">{priceLabel(service)}</p>
  <p class="price-card__duration">{service.duration}</p>
</article>
