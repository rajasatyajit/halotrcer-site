---
// One service from content/pricing.md (owner-set prices: data-owner-source).
import { BOOKING_URL } from '../config/site.ts';
import { formatPrice, type Service } from '../lib/pricing.ts';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}

const { service, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class={`price-card price-card--${service.product}`} data-owner-source="content/pricing.md">
  <Heading class="price-card__name" id={`service-${service.id}`}>
    {service.name}
  </Heading>
  <p class="price-card__price">
    <span class="price-card__from">From</span>
    {formatPrice(service.from)}
  </p>
  <p class="price-card__duration">{service.duration}</p>
  <p>{service.summary}</p>
  <ul class="checklist">
    {service.deliverables.map((d) => (
      <li>{d}</li>
    ))}
  </ul>
  <a class="button" href={BOOKING_URL} aria-describedby={`service-${service.id}`}>
    Book a call
  </a>
</article>
