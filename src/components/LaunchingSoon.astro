---
// Shown wherever install commands would appear while LAUNCHED=false.
import { BOOKING_URL, CONTACT_EMAIL, SITE_NAMES, type SiteId } from '../config/site.ts';

interface Props {
  // 'www' means all three; 'halotrcer' means the bundle alone.
  product?: SiteId | 'halotrcer';
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { product, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const name =
  product === 'halotrcer'
    ? 'Halotrcer'
    : product && product !== 'www'
      ? SITE_NAMES[product]
      : undefined;
const subject = name
  ? `${name} isn’t released yet`
  : 'Tokvera, Sievant and Halotrcer aren’t released yet';
const id = `launching-soon-${product ?? 'all'}`;
---

<section class="launching-soon" aria-labelledby={id} data-launching-soon>
  <p class="eyebrow">Launching soon</p>
  <Heading id={id}>{subject}</Heading>
  <p>
    Install commands will appear here on release day. Until then, book a call to talk through your
    setup, or email us.
  </p>
  <div class="button-row">
    <a class="button" href={BOOKING_URL}>
      Book a call
    </a>
    <a class="button button--ghost" href={`mailto:${CONTACT_EMAIL}`}>
      Email {CONTACT_EMAIL}
    </a>
  </div>
</section>
