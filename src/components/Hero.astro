---
// Hero for a host: headline variant from content/heroes/<site>.yaml (sourced claims).
import { getFlags } from '../config/flags.ts';
import { hero } from '../lib/heroes.ts';

interface Props {
  eyebrow: string;
}

const h = hero(getFlags().site);
---

<section class="container hero" data-hero-variant={h.id}>
  <p class="eyebrow">{Astro.props.eyebrow}</p>
  <h1>
    <span data-claim={h.title.id}>{h.title.text}</span>
  </h1>
  <p class="lede">
    <span data-claim={h.lede.id}>{h.lede.text}</span>
  </p>
  <div class="button-row">
    <slot />
  </div>
</section>
